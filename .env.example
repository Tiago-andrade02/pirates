# PIRATES - Variables de entorno
# Copia este archivo a `.env.local` y completa los valores reales.
# NUNCA comitees secretos reales: solo esta plantilla (sin valores) va al repo.

# ============================================================
# 1) Base de datos (Turso / libSQL) - REQUERIDO en produccion
# ============================================================
# En produccion la app usa Turso remoto. Sin estas dos, tira "SQLite local"
# (solo apto para desarrollo local).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ============================================================
# 2) Mercado Pago - REQUERIDO en produccion (credenciales LIVE)
# ============================================================
# El token debe ser LIVE (empieza con APP_USR-), nunca de test.
# Se valida en el backend: si arranca en produccion sin estos, la app falla
# al checkout (a proposito: no se puede cobrar sin config real).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
# Firma de verficacion del webhook de pagos (lo pones vos al crear el webhook).
MERCADO_PAGO_WEBHOOK_SECRET=

# Diagnostico detallado de pagos (SOLO desarrollo local).
# Cuando vale "true" se loguea a stdout un resumen ESTRUCTURADO del intento de
# pago: monto, metodo, tipo, cuotas y codigos de error de Mercado Pago.
# Nunca se loguean tokens, datos de tarjeta, email, DNI ni respuestas crudas.
# NO ACTIVAR EN VERCEL (ni en produccion ni en preview): el codigo lo ignora si
# NODE_ENV=production, pero dejarlo en "false" es la unica garantia explicita.
ENABLE_PAYMENT_DIAGNOSTICS=false

# ---------- Variables publicas del front (Bricks) ----------
# LA MISMA clave publica que el server, propagada al Payment Brick del browser.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# ============================================================
# 3) Envio: GRATIS SIEMPRE
# ============================================================
# El envio es gratis en TODAS las compras, sin minimo. El precio que se cobra
# esta fijado en el codigo: CUSTOMER_SHIPPING_COST en src/lib/shipping/index.ts.
#
# NO existen variables de "minimo de envio gratis". Cualquier NEXT_PUBLIC_SHIPPING_FREE_MIN
# o SHIPPING_FREE_MIN vieja se ignora por completo: borralas si las tenias.
#
# La UNICA modalidad de entrega es "a domicilio": el retiro en persona esta
# desactivado (ver src/lib/shipping/pickup.ts).

# ============================================================
# 4) Proveedor de envio
# ============================================================
# El proveedor NO se usa para cobrar (el envio es 0). Se usa para despacho.
# flat_rate | paqar | correo-argentino
SHIPPING_PROVIDER=flat_rate
# Tarifa plana (flat_rate): costo fijo interno, nunca se le cobra al cliente.
# SHIPPING_FLAT_RATE=

# ---- PAQ.AR (opcional) ----
# El codigo lee PAQAR_API_KEY y PAQAR_AGREEMENT (NO existe PAQAR_TOKEN).
PAQAR_API_KEY=
PAQAR_AGREEMENT=
# PAQAR_ENV=test apunta al ambiente de pruebas (apitest); cualquier otro valor
# (o vacio) usa el ambiente real. En produccion dejar vacio.
# PAQAR_ENV=
# ---- Correo Argentino (opcional) ----
CORREO_ARGENTINO_API_USER=
CORREO_ARGENTINO_API_PASSWORD=
CORREO_ARGENTINO_CUSTOMER_ID=
CORREO_ARGENTINO_ORIGIN_POSTAL_CODE=
# Enlace de seguimiento que se muestra al cliente cuando el admin no carga una
# URL propia. Si queda vacio se usa el oficial de Correo Argentino.
# CORREO_ARGENTINO_TRACKING_URL=https://www.correoargentino.com.ar/formularios/seguimiento

# ============================================================
# 5) Email de notificacion / admin
# ============================================================
ADMIN_PASSWORD=

# SMTP: credenciales obligatorias para enviar CUALQUIER correo.
# Sin estas tres, no sale ni el aviso al admin ni la confirmacion al cliente.
SMTP_HOST=
# 587 = STARTTLS (el cifrado se negocia en la misma conexion).
# 465 = TLS implicito (la conexion ya nace cifrada).
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE solo debe ser true con TLS IMPLICITO (puerto 465).
# Con el puerto 587 tiene que ser false: ponerlo en true hace que nodemailer
# intente TLS implicito contra un puerto que no lo soporta y la conexion falla.
# Si se deja vacio, el codigo decide solo segun el puerto.
SMTP_SECURE=false

# Destinatario de los avisos al ADMINISTRADOR: nueva orden, y la alerta urgente
# de pedido cobrado sin stock. Admite una sola direccion.
ORDER_NOTIFY_TO=
# Remitente de los avisos al administrador. Si se deja vacio se usa SMTP_USER.
ORDER_NOTIFY_FROM=

# Remitente del correo de CONFIRMACION AL CLIENTE. Conviene que sea distinto de
# ORDER_NOTIFY_FROM: el comprador responde a ese correo y no deberia caer en la
# bandeja del administrador. Si se deja vacio cae en ORDER_NOTIFY_FROM y luego
# en SMTP_USER.
ORDER_CUSTOMER_FROM=

# ============================================================
# 6) WhatsApp (opcional, fallback de notificacion)
# ============================================================
# --- Credenciales de salida (Graph API) ---
WHATSAPP_ACCESS_TOKEN=
# ID del numero emisor PRIMARIO. Lo usa toda la salida (pedido nuevo, alerta sin
# stock y aviso de despacho). Es el numero numerico que da Meta, NO el telefono.
WHATSAPP_PHONE_NUMBER_ID=
# Telefono del negocio, en formato internacional solo digitos (ej 549117xxx).
WHATSAPP_TO=
# --- Webhook entrante (recibir mensajes de los clientes) ---
# Token de verificacion de suscripcion. Meta lo manda en el GET inicial
# (hub.verify_token) y hay que responder con hub.challenge. Es un valor que
# inventas vos: no hay que obtenerlo de ningun lado, solo tenes que poner el
# MISMO string aca y en el panel de Meta. Sin esta variable el GET responde 503.
# No lo compartas ni lo pongas en el repositorio.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (WhatsApp > Configuration > Webhooks > Developer).
# Con esto se valida la firma X-Hub-Signature-256 de cada POST. Es DISTINTO del
# WHATSAPP_ACCESS_TOKEN y mas sensible: da control de la app. Sin esta variable
# el POST responde 503 y no se acepta ningun evento.
WHATSAPP_APP_SECRET=
# ID del SEGUNDO numero de la cuenta, si tienen dos en la misma WABA. Con esto se
# distingue de que numero llego cada mensaje (se guarda como "numero-2" en
# whatsapp_messages.our_number_label). Opcional: si la cuenta tiene un solo
# numero, dejalo vacio. Por ahora solo recibe; la salida sigue yendo por el
# primario.
WHATSAPP_PHONE_NUMBER_ID_2=
# URL del webhook para pegar en el panel de Meta. No es una variable de la app,
# se documenta aca para no buscarla: https://<tu-dominio>/api/whatsapp/webhook
# Con SITE_URL=https://piratesarg.com queda:
#   https://piratesarg.com/api/whatsapp/webhook
# Plantilla APROBADA para "nueva orden", que va al numero del negocio
# (WHATSAPP_TO). Debe tener EXACTAMENTE estas 5 variables, en este orden:
#   {{1}} cliente
#   {{2}} telefono y email de contacto
#   {{3}} pedido: codigo, productos con cantidad y precios unitarios/subtotal,
#         total y envio
#   {{4}} envio: modalidad, CP, localidad, provincia, y la direccion completa
#         (o la sucursal preferida, si el cliente la escribio)
#   {{5}} observaciones del cliente y enlace al pedido en el panel
# Los datos van AGRUPADOS y no uno por variable: las plantillas de WhatsApp usan
# variables posicionales y con muchas variables un {{n}} corrido manda el
# telefono donde deberia ir el total.
# Si Meta ya tiene aprobada una version de 7 variables de esta plantilla,
# reemplazala: con variables de mas la API la rechaza y el aviso no sale.
WHATSAPP_TEMPLATE_NAME=nueva_orden_pirates
# Plantilla APROBADA para la alerta urgente de pedido cobrado sin stock. Debe
# tener EXACTAMENTE estas 7 variables, en este orden:
#   {{1}} codigo del pedido  {{2}} importe cobrado  {{3}} productos con cantidad
#   {{4}} envio              {{5}} estado           {{6}} cliente  {{7}} telefono
# Si se deja vacia se reutiliza WHATSAPP_TEMPLATE_NAME, que NO es lo mismo: esa
# anuncia una venta, esta anuncia plata cobrada sin poder cumplir.
WHATSAPP_STOCK_ALERT_TEMPLATE_NAME=alerta_pedido_sin_stock
# Plantilla APROBADA para avisarle al CLIENTE que su pedido fue despachado. Debe
# tener EXACTAMENTE estas 4 variables, en este orden:
#   {{1}} nombre  {{2}} codigo del pedido  {{3}} seguimiento  {{4}} enlace
# El aviso va al TELEFONO DEL CLIENTE (no a WHATSAPP_TO, que es el numero del
# admin). Si se deja vacia no se envia automaticamente: el admin igual puede
# avisar a mano con el boton "Avisar por WhatsApp" del panel.
WHATSAPP_DISPATCH_TEMPLATE_NAME=despacho_pirates

# ============================================================
# 7) Otros
# ============================================================
# URL publica del sitio. Sin barra final.
# Se usa para: los enlaces de los correos (admin y cliente), la metadata, robots y
# sitemap, y las backUrls / notificationUrl que se le pasan a Mercado Pago.
# Si queda vacia, los correos salen SIN enlace y Mercado Pago usa el host de la
# request.
SITE_URL=https://piratesarg.com

# ============================================================
# 8) Modo de prueba del checkout (SOLO Preview, NUNCA produccion)
# ============================================================
# Con CHECKOUT_TEST_MODE=true (valor exacto) en una Preview de Vercel, el checkout
# crea un pedido real en estado 'pendiente' SIN llamar a Mercado Pago: sirve para
# probar el formulario y el envio gratis. En este modo NO se manda ningun aviso
# por WhatsApp ni email: un pedido pendiente todavia no es una venta, asi que
# anunciarlo seria mentir al numero del negocio.
#
# ATENCION: el pedido se guarda en la MISMA base que apunta TURSO_DATABASE_URL.
# Si la Preview comparte la base de produccion, el pedido de prueba queda insertado
# en la base real (no se cobra ni se descuenta stock, pero ocupa una fila). Para
# una prueba sin ese riesgo, apuntar TURSO_DATABASE_URL de la Preview a una base
# separada. En produccion (VERCEL_ENV=production) el modo NUNCA se activa, aunque
# esta variable valga "true".
# Dejar en false (o sin definir) salvo durante una prueba puntual.
CHECKOUT_TEST_MODE=false
